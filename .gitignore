# Build output.
/build/
# direnv and nix.
/.direnv/
/result*
# Local environment; .env.example is the committed template. Narrower than
# ".env*", which would also ignore the committed .envrc.
.env
.env.*
!.env.example
# Agent worktrees.
/.*/worktrees/
# Test binaries and profiles.
*.test
*.out
# The screenshot generator's frames, before freeze turns them into pictures.
/docs/screenshots/*.ansi
